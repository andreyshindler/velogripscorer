<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <include layout="@layout/header_flow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/join_checkpoint_help"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/join_code_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/jcCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/join_code_hint"
                android:inputType="textCapCharacters"
                android:maxLength="8"
                android:textSize="22sp"
                android:letterSpacing="0.15"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/checkpoint_name_optional"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/jcName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/checkpoint_name_hint"
                android:inputType="textCapWords"
                android:maxLength="60" />

            <Button
                android:id="@+id/jcJoin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/join_checkpoint" />

            <TextView
                android:id="@+id/jcStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/join_checkpoint_note"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
